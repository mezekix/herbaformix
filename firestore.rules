rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GENEL KURALLAR ---
    
    // userProfiles koleksiyonu: Her kullanıcı sadece kendi profilini okuyabilir ve yazabilir.
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // products koleksiyonu: Giriş yapmış herhangi bir kullanıcı tüm ürünleri okuyabilir.
    // (Şimdilik ürün ekleme/silme işlemini sadece konsoldan yaptığımızı varsayıyoruz)
    match /products/{productId} {
      allow read: if request.auth != null;
      // Eğer kullanıcıların ürün eklemesini/silmesini isterseniz buraya 'write' kuralı eklenir.
      // allow write: if ... ; 
    }

    // scheduled_follow_ups koleksiyonu için yeni kurallar
    match /scheduled_follow_ups/{followUpId} {
      // Bir kullanıcının bu koleksiyonda bir dökümanı okumasına veya silmesine,
      // sadece dökümandaki 'consultantId' alanı kendi kullanıcı ID'si ise izin ver.
      allow read, delete: if request.auth != null && resource.data.consultantId == request.auth.uid;
      
      // Bir kullanıcının bu koleksiyona yeni bir döküman eklemesine,
      // sadece oluşturulacak dökümandaki 'consultantId' alanı kendi kullanıcı ID'si ise izin ver.
      allow create: if request.auth != null && request.resource.data.consultantId == request.auth.uid;

      // Bir kullanıcının dökümanı güncellemesine (örn: isCompleted = true yapmak),
      // sadece dökümandaki 'consultantId' alanı kendi kullanıcı ID'si ise izin ver.
      allow update: if request.auth != null && resource.data.consultantId == request.auth.uid;
    }

    // --- KULLANICIYA ÖZEL VERİLER ---

    // Bir kullanıcının kendi dokümanı altındaki tüm alt koleksiyonlar için geçerli olacak kural.
    // Bu kural sayesinde, /users/{userId}/customers, /users/{userId}/orders, 
    // ve /users/{userId}/customers/{customerId}/follow_ups yollarının tümü korunur.
    match /users/{userId}/{document=**} {
      // Bir kullanıcının, kendi belgesinin altındaki herhangi bir veriyi
      // okumasına ve yazmasına sadece kendisi giriş yapmışsa izin ver.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
} 