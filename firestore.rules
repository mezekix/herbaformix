rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GENEL KURALLAR ---
    
    // userProfiles koleksiyonu: Her kullanıcı sadece kendi profilini okuyabilir ve yazabilir.
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // products koleksiyonu: Giriş yapmış herhangi bir kullanıcı tüm ürünleri okuyabilir.
    // (Şimdilik ürün ekleme/silme işlemini sadece konsoldan yaptığımızı varsayıyoruz)
    match /products/{productId} {
      allow read: if request.auth != null;
      // Eğer kullanıcıların ürün eklemesini/silmesini isterseniz buraya 'write' kuralı eklenir.
      // allow write: if ... ; 
    }

    // --- KULLANICIYA ÖZEL VERİLER ---

    // Bir kullanıcının kendi dokümanı altındaki tüm alt koleksiyonlar için geçerli olacak kural.
    // Bu kural sayesinde, /users/{userId}/customers, /users/{userId}/orders, 
    // ve /users/{userId}/customers/{customerId}/follow_ups yollarının tümü korunur.
    match /users/{userId}/{document=**} {
      // Bir kullanıcının, kendi belgesinin altındaki herhangi bir veriyi
      // okumasına ve yazmasına sadece kendisi giriş yapmışsa izin ver.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
} 